<Group hide-input="false" labelreference="L56" drawlabel="true" applyint="true" applyrational="true" applyexponent="false">
<Input><Text-field prompt="&gt; " style="Maple Input" layout="Normal"># Right-hand side after substituting the natural frequency
b1 := evalf(subs(omega = omega1, b)):

# System A1.C = b1
eq_mode := A1 . C - b1:

# Normalize one constant, because mode shapes are relative
# Here we choose _C6 = 1
solC := fsolve(
    {
     eq_mode[1] = 0,
     eq_mode[2] = 0,
     eq_mode[3] = 0,
     eq_mode[4] = 0,
     eq_mode[5] = 0,
     _C6 = 1
    },
    {_C1, _C2, _C3, _C4, _C5, _C6}
):

solC;
assign(solC):
evalf(A1 . Vector([_C1, _C2, _C3, _C4, _C5, _C6]) - b1);</Text-field>
</Input>
